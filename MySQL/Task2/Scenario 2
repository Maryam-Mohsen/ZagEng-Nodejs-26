CREATE DATABASE IF NOT EXISTS HospitalDB;
USE HospitalDB;

CREATE TABLE doctors (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    specialization VARCHAR(50),
    hire_date DATE,
    salary DECIMAL(10, 2),
    consultations_count INT
);

CREATE TABLE patients (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    age INT,
    gender CHAR(1),
    admission_date DATE,
    room_type VARCHAR(50),
    bill_amount DECIMAL(10, 2),
    status VARCHAR(20)
);

