--Task 1
SELECT name, specialization, salary FROM doctors 
WHERE hire_date > '2022-01-01' 
ORDER BY salary DESC LIMIT 5;

--Task 2
SELECT room_type, 
    COUNT(*) AS patient_count, 
    MAX(bill_amount) AS max_bill, 
    MIN(bill_amount) AS min_bill, 
    SUM(bill_amount) AS total_revenue
FROM patients 
GROUP BY room_type 
HAVING SUM(bill_amount) > 5000;

--Task 3
SELECT name, LENGTH(name) AS name_length FROM patients;
SELECT LOWER(specialization) FROM doctors;
SELECT name, DATEDIFF(CURDATE(), admission_date) AS days_in_hospital FROM patients;

